		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Copied %lld email</string>
			<key>other</key>
			<string>Copied %lld emails</string>
		</dict>
	</dict>
	<key>已重启 ChatGPT，稍后在 %lld 个对话里自动续答</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Restarted ChatGPT; %lld conversation will auto-resume shortly</string>
			<key>other</key>
			<string>Restarted ChatGPT; %lld conversations will auto-resume shortly</string>
		</dict>
	</dict>
	<key>应用到 %lld 个对话</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Apply to %lld Conversation</string>
			<key>other</key>
			<string>Apply to %lld Conversations</string>
		</dict>
	</dict>
	<key>改 %lld 个对话，下一轮起生效；没在 ChatGPT 里打开的会在后台逐个打开一下</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Changes %lld conversation from the next turn; if it isn't open in ChatGPT, it's briefly opened in the background</string>
			<key>other</key>
			<string>Changes %lld conversations from the next turn; ones not open in ChatGPT are briefly opened in the background one by one</string>
		</dict>
	</dict>
	<key>暂停 %lld 个对话？</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
